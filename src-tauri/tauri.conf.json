{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kovatube",
  "version": "1.2.0",
  "identifier": "com.kovatube.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kovatube",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "AudioVideo",
    "shortDescription": "YouTube video and music player",
    "longDescription": "Kovatube plays YouTube videos and music, including downloads you already keep in ~/.config/Kovatube."
  }
}
